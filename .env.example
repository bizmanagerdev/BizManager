# BizManager environment — copy to `.env` and fill in real values.
#   cp .env.example .env
# Ask the project owner for the real secrets. NEVER commit a filled-in .env
# (`.env*` is gitignored; only this .example file is tracked).

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key — server-only secret. Required for cron jobs (daily alerts,
# push) and payroll session-delete to read all data / bypass RLS.
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Single provider for ALL AI: voice transcription, voice→task parsing, CC PDF
# extraction. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── Morning / GreenInvoice (Israeli invoicing) ──────────────────────────────
MORNING_API_BASE_URL=https://api.morning.co
MORNING_CLIENT_ID=your-morning-client-id
MORNING_CLIENT_SECRET=your-morning-client-secret
MORNING_SANDBOX=true

# ─── Phone attendance (kosher-phone clock in/out) ────────────────────────────
# Shared secret the telephony provider sends with each call webhook to
# /api/attendance/call (header x-attendance-token, or a token/secret field).
# Pick any long random string and give the same value to the provider.
ATTENDANCE_CALL_TOKEN=your-long-random-shared-secret

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate a key pair once: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Must equal VAPID_PUBLIC_KEY — exposed to the client to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Cron / scheduled jobs ───────────────────────────────────────────────────
# Shared secret guarding the cron API routes (Vercel cron sends it as a bearer).
# Generate: `openssl rand -hex 32`
CRON_SECRET=generate-a-random-32-byte-hex-string

# ─── App defaults ────────────────────────────────────────────────────────────
# UUID of the fallback product category used when none is chosen.
DEFAULT_PRODUCT_CATEGORY_ID=your-default-category-uuid
# Gate for the admin-only payroll center.
PAYROLL_ADMIN_PASSWORD=set-a-strong-password

# ─── Error monitoring (optional) ─────────────────────────────────────────────
# Sentry DSN — referenced by CONTRIBUTING; leave blank to disable locally.
NEXT_PUBLIC_SENTRY_DSN=
