# E2E test environment — copy to `.env.test.local` (gitignored) and fill in
# with the values `supabase start` prints for the LOCAL Docker stack.
#   cp .env.test.example .env.test.local
#
# These must be the LOCAL stack's credentials, never the real project's — see
# e2e/README.md. The local anon/service_role keys are fixed, well-known
# Supabase CLI demo values (safe to see in a screenshot); only the DB itself
# is a secret in the sense that it holds seeded test data, not real data.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-local-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=paste-the-local-service-role-key-from-supabase-start
