{
  "name": "bizh",
  "version": "0.1.0",
  "private": true,
  "comment:overrides": "Force a single copy of Radix's layer-coordination internals so a Popover (searchable-select menu) nested inside a Dialog shares the same dismissable-layer/focus-scope stack — otherwise clicking the menu registers as 'outside' and closes the dialog.",
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.13",
    "@radix-ui/react-focus-scope": "1.1.10"
  },
  "scripts": {
    "dev": "next dev",
    "dev:insecure": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:check": "node scripts/check-db-sql-frozen.mjs",
    "db:refreeze": "ls db/sql/*.sql | xargs -n1 basename | sort > db/sql/.frozen-manifest",
    "db:new": "supabase migration new",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hebcal/core": "^6.5.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sentry/nextjs": "^10.58.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/web-push": "^3.6.4",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-holidays": "^3.28.0",
    "firebase-admin": "^14.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.541.0",
    "next": "16.1.6",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "supabase": "^2.107.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
